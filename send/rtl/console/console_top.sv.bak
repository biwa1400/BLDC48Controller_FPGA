// ====================================================================
// Module: MBL600_encoder_top
// Type  : synthesizable
// Standard: SystemVerilog 2005 (IEEE1800-2005)
// Function: Top-level module instantiating three encoder readers:
//           1) DTC
//           2) Phase Advance
//           3) VS Rho
// ====================================================================

module console_top (
    input  wire clk,    // System clock
    input  wire a,      // Encoder channel A
    input  wire b,      // Encoder channel B
    output wire [6:0]  DTC_wire,
    output wire [12:0] phase_advance_wire,
    output wire [11:0] vs_rho_wire
);

    // -----------------------------------------------------
    // 1️⃣ DTC reader
    // -----------------------------------------------------
    MBL600_encoder_generic #(
        .WIDTH(7),
        .SHIFT_RIGHT(3),
        .VALUE_MIN(7'd20),
        .VALUE_MAX(7'd127)
    ) DTC_inst (
        .clk(clk),
        .a(a),
        .b(b),
        .value_wire(DTC_wire)
    );

    // -----------------------------------------------------
    // 2️⃣ Phase Advance reader
    // -----------------------------------------------------
    MBL600_encoder_generic #(
        .WIDTH(13),
        .SHIFT_RIGHT(2),
        .VALUE_MIN(13'd0),
        .VALUE_MAX(13'd1600)
    ) phase_advance_inst (
        .clk(clk),
        .a(a),
        .b(b),
        .value_wire(phase_advance_wire)
    );

    // -----------------------------------------------------
    // 3️⃣ VS Rho reader
    // -----------------------------------------------------
    MBL600_encoder_generic #(
        .WIDTH(12),
        .SHIFT_RIGHT(2),
        .VALUE_MIN(12'd25),
        .VALUE_MAX(12'd4095)
    ) vs_rho_inst (
        .clk(clk),
        .a(a),
        .b(b),
        .value_wire(vs_rho_wire)
    );

endmodule
