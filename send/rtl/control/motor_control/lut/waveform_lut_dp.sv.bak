// ============================================================================
// waveform_lut_dp.sv
//
// BLDC48Controller FPGA
//
// Dual-bank waveform LUT storage.
//
// Architecture:
//
//                    waveform_lut_dp
//
//        Write port                    Read port
//   (ARM / DMA side)              (calculation side)
//          |                              |
//          v                              v
//     +----------+                     rd_bank
//     | Bank A   |-----------------------+
//     | 4096x13  |                       |
//     +----------+                       |
//                                        +--> rd_data
//     +----------+                       |
//     | Bank B   |-----------------------+
//     | 4096x13  |
//     +----------+
//
// Bank roles:
//
//   active_bank
//       - Defines which bank is currently active at the system level.
//       - Used by the write port for hardware write protection.
//       - ARM / DMA writes to this bank are rejected.
//
//   rd_bank
//       - Selects which bank is read by the calculation datapath.
//       - Intended to come from the phase-command batch snapshot.
//       - Remains stable for the complete 22-phase calculation batch.
//
// Separating active_bank from rd_bank guarantees that one calculation batch
// can continue reading the exact bank captured at batch start.
//
// Responsibilities:
//   - Store two independent 4096 x 13 LUT banks.
//   - Perform synchronous writes.
//   - Perform synchronous reads.
//   - Reject writes to the currently active bank.
//   - Read from the explicitly selected calculation bank.
//
// NOT responsibilities:
//   - Commit protocol.
//   - Pending bank switch.
//   - Batch-boundary detection.
//   - Batch snapshot generation.
//   - Commit acknowledgement.
//
// Those policies belong to lut_bank_control.sv and phase_command_calc.sv.
//
// NOTE ABOUT "always":
//
// The RAM write process intentionally uses ordinary clocked "always" rather
// than "always_ff".
//
// This allows the verification environment to preload the RAM using $readmemh
// through hierarchical access without violating the SystemVerilog always_ff
// single-procedural-driver rule.
//
// This does not change the synthesized sequential behavior of the RAM.
//
// ============================================================================

module waveform_lut_dp (

    input  logic        clk_50MHz,
    input  logic        rst_n,

    // ------------------------------------------------------------------------
    // Current system-level active bank
    //
    // 0 = Bank A active
    // 1 = Bank B active
    //
    // Used only for write protection.
    // ------------------------------------------------------------------------

    input  logic        active_bank,

    // ------------------------------------------------------------------------
    // ARM / DMA write port
    // ------------------------------------------------------------------------

    input  logic        wr_en,
    input  logic        wr_bank,
    input  logic [11:0] wr_addr,
    input  logic [12:0] wr_data,

    // ------------------------------------------------------------------------
    // Calculation read port
    //
    // rd_bank is intentionally independent from active_bank.
    // ------------------------------------------------------------------------

    input  logic        rd_bank,
    input  logic        rd_en,
    input  logic [11:0] rd_addr,
    output logic [12:0] rd_data

);


    // ========================================================================
    // LUT storage
    // ========================================================================

    logic [12:0] bank_a [0:4095];
    logic [12:0] bank_b [0:4095];


    // ========================================================================
    // Write port
    // ========================================================================
    //
    // Important safety rule:
    //
    //     wr_bank == active_bank
    //
    // is never allowed to modify memory.
    //
    // The protection is implemented in FPGA hardware rather than relying on
    // ARM software to always select the inactive bank correctly.
    //
    // Ordinary clocked "always" is intentional here. See file header.
    //
    // ========================================================================

    always @(posedge clk_50MHz) begin

        if (wr_en && (wr_bank != active_bank)) begin

            if (wr_bank == 1'b0) begin

                bank_a[wr_addr] <=
                    wr_data;

            end
            else begin

                bank_b[wr_addr] <=
                    wr_data;

            end

        end

    end


    // ========================================================================
    // Read port
    // ========================================================================
    //
    // Synchronous read.
    //
    // rd_bank and rd_addr are sampled on clk_50MHz when rd_en is asserted.
    //
    // rd_data becomes the selected LUT value after the rising clock edge.
    //
    // The phase-command FSM therefore uses:
    //
    //     LUT_READ
    //         ->
    //     LUT_WAIT
    //         ->
    //     LUT_CAPTURE
    //
    // rd_bank is the bank snapshot associated with the current calculation
    // batch and must remain stable for that complete batch.
    //
    // ========================================================================

    always_ff @(posedge clk_50MHz) begin

        if (!rst_n) begin

            rd_data <=
                13'd0;

        end
        else if (rd_en) begin

            if (rd_bank == 1'b0) begin

                rd_data <=
                    bank_a[rd_addr];

            end
            else begin

                rd_data <=
                    bank_b[rd_addr];

            end

        end

    end


endmodule