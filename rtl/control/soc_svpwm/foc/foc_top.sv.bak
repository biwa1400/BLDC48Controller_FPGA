//end



// 简介    ：该模块是23段式 SVPWM 发生器，用于生成 22 相上的 PWM 信号。
// 输入    ：定子极坐标系下的电压矢量 Vsρ, Vsθ
// 输出    ：PWM使能信号 pwm_en
//           22相PWM信号 pwm_1, pwm_2, pwm_3 ...
// 说明    ：该模块产生的 PWM 的频率是 clk 频率 / 2000。例如 clk 为 50MHz ，则 PWM 的频率为 50MHz / 2000 = 25kHz
svpwm #(
	.LM10_WIDTH   ( LM10_WIDTH               ),  
	.LM10_COUNTS  ( LM10_COUNTS              )
) svpwm_i (
	.clk          ( svpwm_clk                ),
	.v_amp        ( MAX_AMP                  ),
	.v_rho        ( vs_rho                   ),  // input : Vsρ
	.v_theta      ( psi                		  ),  // input : Vsθ
	.pwm_en       ( pwm_en                   ),  // output
	.pwm_1        ( pwm_1                    ),  // output
	.pwm_2        ( pwm_2                    ),  // output
	.pwm_3        ( pwm_3                    ),  // output
	.pwm_4        ( pwm_4                    ),  // output
	.pwm_5        ( pwm_5                    ),  // output
	.pwm_6        ( pwm_6                    ),  // output
	.pwm_7        ( pwm_7                    ),  // output
	.pwm_8        ( pwm_8                    ),  // output
	.pwm_9        ( pwm_9                    ),  // output
	.pwm_10       ( pwm_10                   ),  // output
	.pwm_11       ( pwm_11                   ),  // output
	.pwm_12       ( pwm_12                   ),  // output
	.pwm_13       ( pwm_13                   ),  // output
	.pwm_14       ( pwm_14                   ),  // output
	.pwm_15       ( pwm_15                   ),  // output
	.pwm_16       ( pwm_16                   ),  // output
	.pwm_17       ( pwm_17                   ),  // output
	.pwm_18       ( pwm_18                   ),  // output
	.pwm_19       ( pwm_19                   ),  // output
	.pwm_20       ( pwm_20                   ),  // output
	.pwm_21       ( pwm_21                   ),  // output
	.pwm_22       ( pwm_22                   )   // output
);



// 简介    ：该模块用于控制相电流检测 ADC 的采样时机
// 输入    ：3相PWM信号 pwm_a, pwm_b, pwm_c
// 输出    ：3相电流 ADC 采样时刻控制信号 sn_adc
// 原理    ：该模块检测 pwm_a, pwm_b, pwm_c 均为低电平的时刻，并延迟 SAMPLE_DELAY 的时钟周期，在 sn_adc 信号上产生一个时钟周期的高电平。
hold_detect #(
	.SAMPLE_DELAY ( SAMPLE_DELAY             )
) adc_sn_ctrl_i (
	.rstn         ( init_done                ),
	.clk          ( clk                      ),
	.in           ( ~pwm_1 & ~pwm_2 & ~pwm_3 & ~pwm_4 & ~pwm_5 & ~pwm_6 & ~pwm_7 & ~pwm_8 & ~pwm_9 & ~pwm_10 & ~pwm_11 ),  // input : 当pwm均为低电平时=1，否则=0
	.out          ( sn_adc                   )   // output: 若输入信号=1并保持 SAMPLE_DELAY 个周期，则 sn_adc 上产生1个周期的高电平脉冲
);


endmodule

