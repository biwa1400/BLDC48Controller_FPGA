
// 模块: foc_top
// Type    : synthesizable, IP's top
// Standard: SystemVerilog 2005 (IEEE1800-2005)
// 功能：FOC 算法（仅包含电流环） + SVPWM
// 参数：详见下方注释
// 输入输出：详见下方注释

module foc_top #(
	// ----------------------------------------------- 模块参数 ---------------------------------------------------------------------------------------------------------------------------------------------------
	parameter   							LM10_WIDTH   = `ENCODER_BIT,
	parameter logic [LM10_WIDTH-1:0] LM10_COUNTS  = `ENCODER_BIT'd6400,
	parameter 								ADC_BITS 	 = 12,
	parameter								INIT_CYCLES  = 50000000, // 决定了初始化步骤占多少个时钟(clk)周期，取值范围为1~4294967294。该值不能太短，因为要留足够的时间让转子回归电角度=0。例如若时钟(clk)频率为 50MHz，INIT_CYCLES=50000000，则初始化时间为 50000000/50000000=1 秒
//	parameter logic						ANGLE_INV    = 1'b0,     // 若角度传感器没装反（A->B->C->A 的旋转方向与 φ 增大的方向相同），则该参数应设为 0。若角度传感器装反了（A->B->C->A 的旋转方向与 φ 增大的方向相反），则该参数应设为 1。
	parameter 								POLE_PAIR    = 2'd3,     // 电机极对数 (简记为N)，取值范围1~255，根据电机型号决定。（电角度ψ = 极对数N * 机械角度φ）
	parameter logic [ 8:0] 			 	MAX_AMP      = 9'd384,   // SVPWM 的最大振幅，取值范围为1~511，该值越小，电机能达到的最大力矩越小；但考虑到使用3相下桥臂电阻采样法来采样电流，该值也不能太大，以保证3个下桥臂有足够的持续导通时间来供ADC进行采样。
	parameter logic [ 8:0] 			 	SAMPLE_DELAY = 9'd120,   // 采样延时，取值范围0~511，考虑到3相的驱动 MOS 管从开始导通到电流稳定需要一定的时间，所以从3个下桥臂都导通，到 ADC 采样时刻之间需要一定的延时。该参数决定了该延时是多少个时钟周期，当延时结束时，该模块在 sn_adc 信号上产生一个高电平脉冲，指示外部 ADC “可以采样了”
	parameter logic [23:0] 			 	Kp           = 24'd32768,// 电流环 PID 控制算法的 P 参数
	parameter logic [23:0]				Ki           = 24'd2     // 电流环 PID 控制算法的 I 参数
) (
	// ----------------------------------------------- 驱动时钟和复位 ---------------------------------------------------------------------------------------------------------------------------------------------
	input  wire               				rstn,                 // 复位信号，应该先拉低来对模块进行复位，然后一直保持高电平来让模块正常工作。
	input  wire              				clk,                  // 时钟信号，频率可取几十MHz。控制频率 = 时钟频率 / 2000。比如若时钟频率为 50MHz ，那么控制频率为 50MHz/2000=25kHz。（控制频率 = 3相电流采样的采样率 = PID算法的控制频率 = SVPWM占空比的更新频率）
	input  wire              				svpwm_clk,
	// ----------------------------------------------- 角度传感器输入信号 -----------------------------------------------------------------------------------------------------------------------------------------
	input  wire									encoder_ok,			  // rotate the rotor until encoder Z ref is found.
	input  wire 		 [LM10_WIDTH-1:0]	phi,                  // 从 LM10 磁编码器读出的转子机械角度 φ ，取值范围0~6399。0对应0°；1600对应90°；3200对应180°；4800对应270°。
	input  wire signed [15:0] 				rpm,                  // rotor rpm
	// ----------------------------------------------- 11相电流 ADC 采样时刻控制信号 和采样结果输入信号 ------------------------------------------------------------------------------------------------------------
	output wire              				sn_adc,               // 11相电流 ADC 采样时刻控制信号，当需要进行一次采样时，sn_adc 信号上产生一个时钟周期的高电平脉冲，指示ADC应该进行采样了。
	input  wire               				en_adc,               // 11相电流 ADC 采样结果有效信号，sn_adc 产生高电平脉冲后，外部ADC开始采样11相电流，在转换结束后，应在 en_adc 信号上产生一个周期的高电平脉冲，同时把ADC转换结果产生在 adc_1, adc_2, adc_3 ... 信号上
	input  wire signed [ADC_BITS+1:0]	adc_1, adc_2, adc_3, adc_4, adc_5, adc_6, adc_7, adc_8, adc_9, adc_10, adc_11, // 11相电流 ADC 采样结果，取值范围 -8192 ~ 8190
	// ----------------------------------------------- 22相 PWM 信号，（包含使能信号） -----------------------------------------------------------------------------------------------------------------------------
	output wire               			 	pwm_en,               // 22相共用的使能信号，当 pwm_en=0 时，所有MOS管全部关断。
	output wire               			 	pwm_1,                // 1相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_2,                // 2相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_3,                // 3相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_4,                // 4相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_5,                // 5相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_6,                // 6相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_7,                // 7相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_8,                // 8相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_9,                // 9相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_10,               // 10相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_11,               // 11相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_12,               // 12相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_13,               // 13相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_14,               // 14相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_15,               // 15相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_16,               // 16相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_17,               // 17相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_18,               // 18相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_19,               // 19相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_20,               // 20相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_21,               // 21相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	output wire               			 	pwm_22,               // 22相PWM信号。当 =0 时。下桥臂导通；当 =1 时，上桥臂导通
	// ----------------------------------------------- d/q轴（转子直角坐标系）的电流监测 --------------------------------------------------------------------------------------------------------------------------
	output wire               			 	en_idq,               // 出现高电平脉冲时说明 id 和 iq 出现了新值，每个控制周期 en_idq 会产生一个高电平脉冲
	output wire signed [15:0] 			 	id,                   // d 轴（直轴）的实际电流值（简记为 Id），可正可负
	output wire signed [15:0] 			 	iq,                   // q 轴（交轴）的实际电流值（简记为 Iq），可正可负（若正代表逆时针，则负代表顺时针，反之亦然）
	// ----------------------------------------------- d/q轴（转子直角坐标系）的电流控制目标 ----------------------------------------------------------------------------------------------------------------------
	input  wire signed [15:0] 			 	id_aim,               // d 轴（直轴）的目标电流值（简记为 Idaim），可正可负，在不使用弱磁控制的情况下一般设为0
	input  wire signed [15:0] 			 	iq_aim,               // q 轴（直轴）的目标电流值（简记为 Iqaim），可正可负（若正代表逆时针，则负代表顺时针，反之亦然）
	// ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
	output reg               				init_done,            // 初始化结束信号。在初始化结束前=0，在初始化结束后（进入FOC控制状态）=1
	input reg									init_start,				  // ready to start checking rotor angle init_phi
	input reg			 [11:0]				vs_rho,
	input reg			 [LM10_WIDTH-1:0]	init_phi,
	input reg			 [LM10_WIDTH-1:0]	phase_advance
);

reg         [31:0] 			  init_cnt;
//reg         [LM10_WIDTH-1:0] init_phi = `ENCODER_BIT'd490;      // 初始机械角度（简记为 Φ）。即电角度=0时对应的机械角度，在初始化结束时被确定，用来在之后进行机械角度到电角度的转换。取值范围0~4095。0对应0°；1024对应90°；2048对应180°；3072对应270°。

reg         [LM10_WIDTH-1:0] psi;           // 当前电角度（简记为 ψ）。取值范围0~6399。0对应0°；1600对应90°；3200对应180°；4800对应270°。
reg			[LM10_WIDTH+1:0] psi_temp;
reg			[LM10_WIDTH-1:0] psi_temp2;

wire               			  en_ialphabeta; // α/β轴（定子直角坐标系）上的电流矢量有效信号，在产生高电平脉冲时，说明 Iα, Iβ 发生更新
wire signed [ADC_BITS+5:0]	  ialpha, ibeta; // α/β轴（定子直角坐标系）上的电流矢量。ialpha 是 α 轴的分量（简记为 Iα），ibeta 是 β 轴的分量（简记为 Iβ）

wire signed [15:0] 			  vd, vq;        // d/q轴（转子直角坐标系）上的电压矢量，是 PID 算法输出的值。Vd 是 d 轴 上的电压分量，Vq 是 q 轴上的电压分量

wire        [11:0] 			  vr_rho;        // 转子极坐标系上的电压矢量的幅值（简记为 Vrρ ），由 Vd 和 Vq 转换到极坐标系得来，具体地讲，Vrρ = √(Vd^2+Vq^2)
wire        [LM10_WIDTH-1:0] vr_theta;      // 转子极坐标系上的电压矢量的角度（简记为 Vrθ ），由 vd 和 vq 转换到极坐标系得来，具体地讲，Vrθ = arctan(Vq/Vd) 。取值范围0~6399。0对应0°；1600对应90°；3200对应180°；4800对应270°。

//reg         [11:0] 			  vs_rho;        // 定子极坐标系上的电压矢量的幅值（简记为 Vsρ ），由 Vrρ 做旋转变换得来，由于幅值的旋转不变性，实际上 Vsρ = Vrρ。 通过 SVPWM 模块，Vsρ 和 Vsθ 可以产生 3 相 PWM 信号
//reg         [LM10_WIDTH-1:0] vs_theta;      // 定子极坐标系上的电压矢量的角度（简记为 Vsθ ），由 Vrθ 做旋转变换得来，由于转子极坐标系是定子极坐标系旋转 ψ 得来，所以 Vsθ = Vrθ + ψ。 通过 SVPWM 模块，Vsρ 和 Vsθ 可以产生 3 相 PWM 信号。 Vsθ取值范围0~6399。0对应0°；1600对应90°；3200对应180°；4800对应270°。
reg			[LM10_WIDTH:0]	  vs_theta_temp;


// 简介    ：该 always 块负责从机械角度 φ 算出电角度 ψ
// 参数    ：极对数 N （参数POLE_PAIR）
// 输入    ：机械角度 φ
//           初始机械角度 Φ
// 输出    ：电角度 ψ
// 计算公式：   ψ =  N * (φ - Φ)    （若 A->B->C->A 的旋转方向与 φ 增大的方向相同）
//         ：或 ψ = -N * (φ - Φ)    （若 A->B->C->A 的旋转方向与 φ 增大的方向相反，即角度传感器装反了）
// 输出更新：只要 φ 改变，ψ 就在下一周期立即改变
//generate if(ANGLE_INV) begin                              // 如果角度传感器装反了
always @ (posedge clk)
	begin
		if (init_phi >= phi)
			psi_temp <= POLE_PAIR * (init_phi - phi);
		else
			psi_temp <= POLE_PAIR * ((LM10_COUNTS - phi) + init_phi);
		if (psi_temp < LM10_COUNTS)
			psi_temp2 <= `ENCODER_BIT'(psi_temp);
		else if (psi_temp >= LM10_COUNTS && psi_temp < 2*LM10_COUNTS)
			psi_temp2 <= `ENCODER_BIT'(psi_temp - LM10_COUNTS);
		else if (psi_temp >= 2*LM10_COUNTS && psi_temp < 3*LM10_COUNTS)
			psi_temp2 <= `ENCODER_BIT'(psi_temp - LM10_COUNTS*2);
//			if (init_phi >= phi)
//				psi <= (POLE_PAIR * (init_phi - phi)) % LM10_COUNTS;
//			else
//				psi <= (POLE_PAIR * (LM10_COUNTS + init_phi - phi)) % LM10_COUNTS;
	end
//end else begin                                            // 如果角度传感器没装反
//	always @ (posedge clk)
//	begin
//		if (phi >= init_phi)
//			psi_temp <= POLE_PAIR * (phi - init_phi);
//		else
//			psi_temp <= POLE_PAIR * ((LM10_COUNTS - init_phi) + phi);
//		
//		if (psi_temp < LM10_COUNTS)
//			psi <= `ENCODER_BIT'(psi_temp);
//		else if (psi_temp >= LM10_COUNTS && psi_temp < 2*LM10_COUNTS)
//			psi <= `ENCODER_BIT'(psi_temp - LM10_COUNTS);
//		else if (psi_temp >= 2*LM10_COUNTS && psi_temp < 3*LM10_COUNTS)
//			psi <= `ENCODER_BIT'(psi_temp - LM10_COUNTS*2);
////			if (phi >= init_phi)
////				psi <= (POLE_PAIR * (phi - init_phi)) % LM10_COUNTS;
////			else
////				psi <= (POLE_PAIR * (LM10_COUNTS + phi - init_phi)) % LM10_COUNTS;
//	end
//end endgenerate


// phase_advance on psi
always @ (posedge clk)
begin
	if (psi_temp2 >= phase_advance)
		psi <= psi_temp2 - phase_advance;
	else
		psi <= LM10_COUNTS - phase_advance + psi_temp2;
end


// 简介    ：该模块用于进行 clark 变换，根据 11 相电流计算 α/β 轴（定子直角坐标系）的电流矢量
// 输入    ：相电流 I1 --- I11
// 输出    ：α/β 轴的电流矢量 Iα, Iβ
// 输出更新：en_iabc 每产生一个高电平脉冲后的若干周期后 Iα, Iβ 更新，同时 en_ialphabeta 产生一个时钟周期的高电平脉冲，即更新频率 = 控制周期
clark_tr #(
	.ADC_BITS	  ( ADC_BITS					  )
) clark_tr_i (
	.rstn         ( init_done					  ),
	.clk          ( clk							  ),
	.i_en         ( en_adc						  ),
	.i_i1         ( adc_1						  ),  // input : I1
	.i_i2         ( adc_2						  ),  // input : I2
	.i_i3         ( adc_3						  ),  // input : I3
	.i_i4         ( adc_4						  ),  // input : I4
	.i_i5         ( adc_5						  ),  // input : I5
	.i_i6         ( adc_6						  ),  // input : I6
	.i_i7         ( adc_7						  ),  // input : I7
	.i_i8         ( adc_8						  ),  // input : I8
	.i_i9         ( adc_9						  ),  // input : I9
	.i_i10        ( adc_10						  ),  // input : I10
	.i_i11        ( adc_11						  ),  // input : I11
	.o_en         ( en_ialphabeta				  ),
	.o_ialpha     ( ialpha						  ),  // output: Iα
	.o_ibeta      ( ibeta						  )   // output: Iβ
);



// 简介    ：该模块用于进行 park 变换，根据 α/β 轴（定子直角坐标系）的电流矢量 计算 d/q 轴（转子直角坐标系）的电流矢量
// 输入    ：电角度 ψ
//           α/β 轴的电流矢量 Iα, Iβ
// 输出    ：d/q 轴的电流矢量 Id, Iq
// 计算公式：Id = Iα * cosψ + Iβ * sinψ;
//           Iq = Iβ * cosψ - Iα * sinψ;
// 输出更新：en_ialphabeta 每产生一个高电平脉冲后的若干周期后 Id, Iq 更新，同时 en_idq 产生一个时钟周期的高电平脉冲，即更新频率 = 控制周期
wire [1:0] trash;    // ignore low 2 bits
park_tr #(
	.LM10_WIDTH   ( LM10_WIDTH               ),
	.LM10_COUNTS  ( LM10_COUNTS              ),
	.ADC_BITS	  ( ADC_BITS					  )
) park_tr_i (
	.rstn         ( init_done                ),
	.clk          ( clk                      ),
	.psi          ( psi                      ),  // input : ψ
	.i_en         ( en_ialphabeta            ),
	.i_ialpha     ( ialpha                   ),  // input : Iα
	.i_ibeta      ( ibeta                    ),  // input : Iβ
	.o_en         ( en_idq						  ),
	.o_id         ( {id,trash}					  ),  // output: Id
	.o_iq         ( {iq,trash}               )   // output: Iq
);



// 简介    ：该模块用于进行 Id (电流矢量在d轴的分量) 的 PID 控制，根据 Id 的目标值（id_aim）和 Id 的实际值（id），算出执行变量 Vd（电压矢量在d轴上的分量）
// 输入    ：电流矢量在d轴的分量的实际值（id）
//           电流矢量在d轴的分量的目标值（id_aim）
// 输出    ：电压矢量在d轴上的分量（vd）
// 原理    ：PID 控制（实际上没有D，只有P和I）
// 输出更新：en_idq 每产生一个高电平脉冲后的若干周期后 Vd 更新，即更新频率 = 控制周期
pi_controller #(
	.Kp           ( Kp                       ),
	.Ki           ( Ki                       )
) pi_id_i (
	.rstn         ( init_done                ),
	.clk          ( clk                      ),
	.i_en         ( en_idq                   ),
	.i_aim        ( id_aim                   ),  // input : Idaim
	.i_real       ( id                       ),  // input : Id
	.o_en         (                          ),
	.o_value      ( vd                       )   // output: Vd
);



// 简介    ：该模块用于进行 Iq (电流矢量在q轴的分量) 的 PID 控制，根据 Iq 的目标值（iq_aim）和 Iq 的实际值（iq），算出执行变量 Vq（电压矢量在d轴上的分量）
// 输入    ：电流矢量在q轴的分量的实际值（iq）
//           电流矢量在q轴的分量的目标值（iq_aim）
// 输出    ：电压矢量在q轴上的分量（vq）
// 原理    ：PID 控制（实际上没有D，只有P和I）
// 输出更新：en_idq 每产生一个高电平脉冲后的若干周期后 Vq 更新，即更新频率 = 控制周期
pi_controller #(
	.Kp           ( Kp                       ),
	.Ki           ( Ki                       )
) pi_iq_i (
	.rstn         ( init_done                ),
	.clk          ( clk                      ),
	.i_en         ( en_idq                   ),
	.i_aim        ( iq_aim                   ),  // input : Iqaim
	.i_real       ( iq                       ),  // input : Iq
	.o_en         (                          ),
	.o_value      ( vq                       )   // output: Vq
);



// 简介    ：该模块用于把电压矢量从转子直角坐标系 (Vd, Vq) 变换到转子极坐标系 (Vrρ, Vrθ)
// 输入    ：电压矢量在转子直角坐标系的 d 轴上的分量（Vd）
//           电压矢量在转子直角坐标系的 q 轴上的分量（Vq）
// 输出    ：电压矢量在转子极坐标系上的幅值（Vrρ）
// 原理    ：电压矢量在转子极坐标系上的角度（Vrθ）
// 输出更新：Vd, Vq 每产生变化的若干周期后 Vrρ 和 Vrθ 更新，更新频率 = 控制周期
cartesian2polar #(
	.LM10_WIDTH   ( LM10_WIDTH               ),  
	.LM10_COUNTS  ( LM10_COUNTS              )
) cartesian2polar_i (
	.rstn         ( init_done                ),
	.clk          ( clk                      ),
	.i_en         ( 1'b1                     ),
	.i_x          ( vd                       ),  // input : Vd
	.i_y          ( vq                       ),  // input : Vq
	.o_en         (                          ),
	.o_rho        ( vr_rho                   ),  // output: Vrρ
	.o_theta      ( vr_theta                 )   // output: Vrθ
);



//always @ (posedge clk or negedge rstn)
//begin
//	if (~rstn) begin
//		init_start <= 1'b0;
//	end else begin
//		if (encoder_ok && rpm == 16'sd0)
//			init_start <= 1'b1;
//	end
//end

reg signed [12:0] vs_rho_temp;

// 简介    ：该 always 块用于进行初始化 和 反park变换
//           一、初始化： 进行初始机械角度标定。首先令 Vsρ 取最大，Vsθ=0，则转子自然会转到电角度 ψ=0 的地方。然后记录下此时的机械角度 φ 作为初始机械角度 Φ 。则之后就可以用公式 ψ = N * (φ - Φ) 计算电角度。
//           二、反park变换： 初始化完成后，持续地把电压矢量从转子极坐标系 (Vrρ, Vrθ) 变换到 定子极坐标系 (Vsρ, Vsθ)
// 输入    ：φ，Vrρ, Vrθ
// 输出    ：Φ，Vsρ, Vsθ，init_done
always @ (posedge clk)
begin
	if (init_start) begin
//			if (phi<=13'd4095) begin      // 若 init_cnt 计数变量 <= INIT_CYCLES ，则初始化未完成
//				vs_rho_temp <= $signed({1'b0, vs_rho}) + $signed(rpm>>>4);              //    初始化阶段令 Vsρ 取最大
//				if (vs_rho_temp < 13'd0)
//					vs_rho <= '0;
//				else if (vs_rho_temp > 13'd4095)
//					vs_rho <= 13'd4095;
//				else
//					vs_rho <= vs_rho_temp[11:0];
//				vs_theta <= '0;  						//    初始化阶段令 Vsθ = 0
//				init_cnt <= init_cnt + 1;
//				if (init_cnt==INIT_CYCLES) begin  // 若 init_cnt 计数变量 == INIT_CYCLES , 说明初始化即将完成
//					init_phi <= phi;             //    记录当前机械角度φ 作为初始机械角度 Φ
		init_done <= 1'b1;           //    令 init_done = 1 ，指示初始化结束
//				end
//			end else begin                       // 若 init_cnt 计数变量 > INIT_CYCLES ，则初始化完成
//				vs_rho <= vr_rho;                //    反park变换。由于幅值的旋转不变性，Vsρ = Vrρ
//				vs_theta_temp = vr_theta + psi;      //    反park变换。由于转子极坐标系是定子极坐标系旋转 ψ 得来，所以 Vsθ = Vrθ + ψ
////				vs_theta <= `ENCODER_BIT'(({1'b0, vr_theta} + {1'b0, psi}) % LM10_COUNTS);      //    反park变换。由于转子极坐标系是定子极坐标系旋转 ψ 得来，所以 Vsθ = Vrθ + ψ
//				vs_theta <= (vs_theta_temp < LM10_COUNTS) ? `ENCODER_BIT'(vs_theta_temp) : `ENCODER_BIT'(vs_theta_temp - LM10_COUNTS);
//			end
	end else begin
		init_done <= 1'b0;
	end
end



//always @ (posedge clk or negedge rstn)
