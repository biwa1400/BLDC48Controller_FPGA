
// 模块：svpwm
// Type    : synthesizable
// Standard: SystemVerilog 2005 (IEEE1800-2005)
// 功能：23 段式 SVPWM 生成器（调制器） 
// 输入：定子极坐标系下的电压矢量 Vsρ, Vsθ
// 输出：PWM使能信号 pwm_en
//       22相PWM信号 pwm_1, pwm_2, pwm_3 ...
// 说明：该模块产生的 PWM 的频率是 clk 频率 / 40000。例如 clk 为 400MHz ，则 PWM 的频率为 400MHz/40000=10kHz

module svpwm #(
	parameter LM10_WIDTH  = `ENCODER_BIT,
	parameter LM10_COUNTS = `ENCODER_BIT'd6400
) (
//	input  wire        				rstn,
	input  wire        				clk,
	input  wire [ 8:0] 				v_amp,                       // svpwm 的最大电压矢量的幅值
	input  wire [11:0] 				v_rho,                       // 定子极坐标系下的电压矢量的幅值 Vsρ
	input  wire [LM10_WIDTH-1:0]	v_theta,                     // 定子极坐标系下的电压矢量的角度 Vsθ
	output reg         				pwm_en, pwm_1, pwm_2, pwm_3, pwm_4, pwm_5, pwm_6, pwm_7, pwm_8, pwm_9, pwm_10, pwm_11, pwm_12, pwm_13, pwm_14, pwm_15, pwm_16, pwm_17, pwm_18, pwm_19, pwm_20, pwm_21, pwm_22  // PWM使能信号 pwm_en, 22相PWM信号 pwm_1, pwm_2, pwm_3 ...
);

//localparam ROM_LATENCY = 13'd4;
localparam CLK_DIV = 16'd40000;

reg  [15:0] 			 cnt;
reg  [LM10_WIDTH-1:0] rom_x;
reg         			 rom_sy;
reg  [ 8:0] 			 rom_y;
reg  [ 8:0] 			 mul_i1;
reg  [11:0] 			 mul_i2;
wire [20:0] 			 mul_y = mul_i1 * mul_i2;
reg  [12:0] 			 mul_o;
reg         			 sy1, sy2, sy3, sy4, sy5, sy6, sy7, sy8, sy9, sy10, sy11, sy12, sy13, sy14, sy15, sy16, sy17, sy18, sy19, sy20, sy21, sy22;
reg  [12:0] 			 yy1, yy2, yy3, yy4, yy5, yy6, yy7, yy8, yy9, yy10, yy11, yy12, yy13, yy14, yy15, yy16, yy17, yy18, yy19, yy20, yy21;
reg  [14:0] 			 pwm1_duty, pwm2_duty, pwm3_duty, pwm4_duty, pwm5_duty, pwm6_duty, pwm7_duty, pwm8_duty, pwm9_duty, pwm10_duty, pwm11_duty, pwm12_duty, pwm13_duty, pwm14_duty, pwm15_duty, pwm16_duty, pwm17_duty, pwm18_duty, pwm19_duty, pwm20_duty, pwm21_duty, pwm22_duty;
reg  [15:0] 			 pwm1_lb, pwm1_ub, pwm2_lb, pwm2_ub, pwm3_lb, pwm3_ub, pwm4_lb, pwm4_ub, pwm5_lb, pwm5_ub, pwm6_lb, pwm6_ub, pwm7_lb, pwm7_ub, pwm8_lb, pwm8_ub, pwm9_lb, pwm9_ub, pwm10_lb, pwm10_ub, pwm11_lb, pwm11_ub, pwm12_lb, pwm12_ub, pwm13_lb, pwm13_ub, pwm14_lb, pwm14_ub, pwm15_lb, pwm15_ub, pwm16_lb, pwm16_ub, pwm17_lb, pwm17_ub, pwm18_lb, pwm18_ub, pwm19_lb, pwm19_ub, pwm20_lb, pwm20_ub, pwm21_lb, pwm21_ub, pwm22_lb, pwm22_ub;
reg         			 pwm_act;

always @ (posedge clk)
begin
	mul_o <= mul_y[20:8];
end

always @ (posedge clk)
begin
	cnt <= cnt + 16'd1;
	if (cnt == CLK_DIV - 16'd1)
		cnt <= '0;
end

//always @ (posedge clk or negedge rstn)
//begin
//	if (~rstn)
//		mul_o <= '0;
//	else
//		mul_o <= mul_y[20:8];
//end
//
//always @ (posedge clk or negedge rstn)
//begin
//	if (~rstn)
//		cnt <= '0;
//	else begin
//		cnt <= cnt + 16'd1;
//		if (cnt == CLK_DIV - 16'd1)
//			cnt <= '0;
//	end
//end

always @ (posedge clk)
begin
	if (cnt == CLK_DIV - 16'd30) begin
		rom_x  <= v_theta;
		mul_i1 <= v_amp;
		mul_i2 <= v_rho;
	end else if (cnt == CLK_DIV - 16'd29) begin
		rom_x <= (rom_x >= `ENCODER_BIT'd291) ? rom_x - `ENCODER_BIT'd291 : (LM10_COUNTS - `ENCODER_BIT'd291) + rom_x;
	end else if (cnt == CLK_DIV - 16'd28) begin
		rom_x  <= (rom_x >= `ENCODER_BIT'd291) ? rom_x - `ENCODER_BIT'd291 : (LM10_COUNTS - `ENCODER_BIT'd291) + rom_x;
		mul_i2 <= mul_o[12:1];
	end else if (cnt == CLK_DIV - 16'd27) begin
		rom_x <= (rom_x >= `ENCODER_BIT'd291) ? rom_x - `ENCODER_BIT'd291 : (LM10_COUNTS - `ENCODER_BIT'd291) + rom_x;
	end else if (cnt == CLK_DIV - 16'd26) begin
		rom_x <= (rom_x >= `ENCODER_BIT'd291) ? rom_x - `ENCODER_BIT'd291 : (LM10_COUNTS - `ENCODER_BIT'd291) + rom_x;
	end else if (cnt == CLK_DIV - 16'd25) begin
		rom_x  <= (rom_x >= `ENCODER_BIT'd291) ? rom_x - `ENCODER_BIT'd291 : (LM10_COUNTS - `ENCODER_BIT'd291) + rom_x;
		mul_i1 <= rom_y;
		sy1    <= rom_sy;
	end else if (cnt == CLK_DIV - 16'd24) begin
		rom_x  <= (rom_x >= `ENCODER_BIT'd290) ? rom_x - `ENCODER_BIT'd290 : (LM10_COUNTS - `ENCODER_BIT'd290) + rom_x;
		mul_i1 <= rom_y;
		sy2    <= rom_sy;
	end else if (cnt == CLK_DIV - 16'd23) begin
		rom_x  <= (rom_x >= `ENCODER_BIT'd291) ? rom_x - `ENCODER_BIT'd291 : (LM10_COUNTS - `ENCODER_BIT'd291) + rom_x;
		mul_i1 <= rom_y;
		sy3    <= rom_sy;
		yy1     <= mul_o;
	end else if (cnt == CLK_DIV - 16'd22) begin
		rom_x  <= (rom_x >= `ENCODER_BIT'd291) ? rom_x - `ENCODER_BIT'd291 : (LM10_COUNTS - `ENCODER_BIT'd291) + rom_x;
		mul_i1 <= rom_y;
		sy4    <= rom_sy;
		yy2     <= mul_o;
	end else if (cnt == CLK_DIV - 16'd21) begin
		rom_x  <= (rom_x >= `ENCODER_BIT'd291) ? rom_x - `ENCODER_BIT'd291 : (LM10_COUNTS - `ENCODER_BIT'd291) + rom_x;
		mul_i1 <= rom_y;
		sy5    <= rom_sy;
		yy3     <= mul_o;
	end else if (cnt == CLK_DIV - 16'd20) begin
		rom_x  <= (rom_x >= `ENCODER_BIT'd291) ? rom_x - `ENCODER_BIT'd291 : (LM10_COUNTS - `ENCODER_BIT'd291) + rom_x;
		mul_i1 <= rom_y;
		sy6    <= rom_sy;
		yy4    <= mul_o;
	end else if (cnt == CLK_DIV - 16'd19) begin
		rom_x  <= (rom_x >= `ENCODER_BIT'd291) ? rom_x - `ENCODER_BIT'd291 : (LM10_COUNTS - `ENCODER_BIT'd291) + rom_x;
		mul_i1 <= rom_y;
		sy7    <= rom_sy;
		yy5    <= mul_o;
	end else if (cnt == CLK_DIV - 16'd18) begin
		rom_x  <= (rom_x >= `ENCODER_BIT'd291) ? rom_x - `ENCODER_BIT'd291 : (LM10_COUNTS - `ENCODER_BIT'd291) + rom_x;
		mul_i1 <= rom_y;
		sy8    <= rom_sy;
		yy6    <= mul_o;
	end else if (cnt == CLK_DIV - 16'd17) begin
		rom_x  <= (rom_x >= `ENCODER_BIT'd291) ? rom_x - `ENCODER_BIT'd291 : (LM10_COUNTS - `ENCODER_BIT'd291) + rom_x;
		mul_i1 <= rom_y;
		sy9    <= rom_sy;
		yy7    <= mul_o;
	end else if (cnt == CLK_DIV - 16'd16) begin
		rom_x  <= (rom_x >= `ENCODER_BIT'd291) ? rom_x - `ENCODER_BIT'd291 : (LM10_COUNTS - `ENCODER_BIT'd291) + rom_x;
		mul_i1 <= rom_y;
		sy10   <= rom_sy;
		yy8    <= mul_o;
	end else if (cnt == CLK_DIV - 16'd15) begin
		rom_x  <= (rom_x >= `ENCODER_BIT'd291) ? rom_x - `ENCODER_BIT'd291 : (LM10_COUNTS - `ENCODER_BIT'd291) + rom_x;
		mul_i1 <= rom_y;
		sy11   <= rom_sy;
		yy9    <= mul_o;
	end else if (cnt == CLK_DIV - 16'd14) begin
		rom_x  <= (rom_x >= `ENCODER_BIT'd291) ? rom_x - `ENCODER_BIT'd291 : (LM10_COUNTS - `ENCODER_BIT'd291) + rom_x;
		mul_i1 <= rom_y;
		sy12   <= rom_sy;
		yy10   <= mul_o;
	end else if (cnt == CLK_DIV - 16'd13) begin
		rom_x  <= (rom_x >= `ENCODER_BIT'd290) ? rom_x - `ENCODER_BIT'd290 : (LM10_COUNTS - `ENCODER_BIT'd290) + rom_x;
		mul_i1 <= rom_y;
		sy13   <= rom_sy;
		yy11   <= mul_o;
	end else if (cnt == CLK_DIV - 16'd12) begin
		rom_x  <= (rom_x >= `ENCODER_BIT'd291) ? rom_x - `ENCODER_BIT'd291 : (LM10_COUNTS - `ENCODER_BIT'd291) + rom_x;
		mul_i1 <= rom_y;
		sy14   <= rom_sy;
		yy12   <= mul_o;
	end else if (cnt == CLK_DIV - 16'd11) begin
		rom_x  <= (rom_x >= `ENCODER_BIT'd291) ? rom_x - `ENCODER_BIT'd291 : (LM10_COUNTS - `ENCODER_BIT'd291) + rom_x;
		mul_i1 <= rom_y;
		sy15   <= rom_sy;
		yy13   <= mul_o;
	end else if (cnt == CLK_DIV - 16'd10) begin
		rom_x  <= (rom_x >= `ENCODER_BIT'd291) ? rom_x - `ENCODER_BIT'd291 : (LM10_COUNTS - `ENCODER_BIT'd291) + rom_x;
		mul_i1 <= rom_y;
		sy16   <= rom_sy;
		yy14   <= mul_o;
	end else if (cnt == CLK_DIV - 16'd9) begin
		rom_x  <= (rom_x >= `ENCODER_BIT'd291) ? rom_x - `ENCODER_BIT'd291 : (LM10_COUNTS - `ENCODER_BIT'd291) + rom_x;
		mul_i1 <= rom_y;
		sy17   <= rom_sy;
		yy15   <= mul_o;
	end else if (cnt == CLK_DIV - 16'd8) begin
		mul_i1 <= rom_y;
		sy18   <= rom_sy;
		yy16   <= mul_o;
	end else if (cnt == CLK_DIV - 16'd7) begin
		mul_i1 <= rom_y;
		sy19   <= rom_sy;
		yy17   <= mul_o;
	end else if (cnt == CLK_DIV - 16'd6) begin
		mul_i1 <= rom_y;
		sy20   <= rom_sy;
		yy18   <= mul_o;
	end else if (cnt == CLK_DIV - 16'd5) begin
		mul_i1 <= rom_y;
		sy21   <= rom_sy;
		yy19    <= mul_o;
	end else if (cnt == CLK_DIV - 16'd4) begin
		mul_i1 <= rom_y;
		sy22   <= rom_sy;
		yy20   <= mul_o;
	end else if (cnt == CLK_DIV - 16'd3) begin
		yy21 <= mul_o;
	end else if (cnt == CLK_DIV - 16'd2) begin
		pwm1_duty  <= sy1  ? 15'd10000-{2'b0, yy1  } : 15'd10000+{2'b0, yy1  };
		pwm2_duty  <= sy2  ? 15'd10000-{2'b0, yy2  } : 15'd10000+{2'b0, yy2  };
		pwm3_duty  <= sy3  ? 15'd10000-{2'b0, yy3  } : 15'd10000+{2'b0, yy3  };
		pwm4_duty  <= sy4  ? 15'd10000-{2'b0, yy4  } : 15'd10000+{2'b0, yy4  };
		pwm5_duty  <= sy5  ? 15'd10000-{2'b0, yy5  } : 15'd10000+{2'b0, yy5  };
		pwm6_duty  <= sy6  ? 15'd10000-{2'b0, yy6  } : 15'd10000+{2'b0, yy6  };
		pwm7_duty  <= sy7  ? 15'd10000-{2'b0, yy7  } : 15'd10000+{2'b0, yy7  };
		pwm8_duty  <= sy8  ? 15'd10000-{2'b0, yy8  } : 15'd10000+{2'b0, yy8  };
		pwm9_duty  <= sy9  ? 15'd10000-{2'b0, yy9  } : 15'd10000+{2'b0, yy9  };
		pwm10_duty <= sy10 ? 15'd10000-{2'b0, yy10 } : 15'd10000+{2'b0, yy10 };
		pwm11_duty <= sy11 ? 15'd10000-{2'b0, yy11 } : 15'd10000+{2'b0, yy11 };
		pwm12_duty <= sy12 ? 15'd10000-{2'b0, yy12 } : 15'd10000+{2'b0, yy12 };
		pwm13_duty <= sy13 ? 15'd10000-{2'b0, yy13 } : 15'd10000+{2'b0, yy13 };
		pwm14_duty <= sy14 ? 15'd10000-{2'b0, yy14 } : 15'd10000+{2'b0, yy14 };
		pwm15_duty <= sy15 ? 15'd10000-{2'b0, yy15 } : 15'd10000+{2'b0, yy15 };
		pwm16_duty <= sy16 ? 15'd10000-{2'b0, yy16 } : 15'd10000+{2'b0, yy16 };
		pwm17_duty <= sy17 ? 15'd10000-{2'b0, yy17 } : 15'd10000+{2'b0, yy17 };
		pwm18_duty <= sy18 ? 15'd10000-{2'b0, yy18 } : 15'd10000+{2'b0, yy18 };
		pwm19_duty <= sy19 ? 15'd10000-{2'b0, yy19 } : 15'd10000+{2'b0, yy19 };
		pwm20_duty <= sy20 ? 15'd10000-{2'b0, yy20 } : 15'd10000+{2'b0, yy20 };
		pwm21_duty <= sy21 ? 15'd10000-{2'b0, yy21 } : 15'd10000+{2'b0, yy21 };
		pwm22_duty <= sy22 ? 15'd10000-{2'b0, mul_o} : 15'd10000+{2'b0, mul_o};
	end else if (cnt == CLK_DIV - 16'd1) begin
		pwm1_lb  <= 16'd0 + {1'b0, pwm1_duty };
		pwm1_ub  <= CLK_DIV - {1'b0, pwm1_duty };
		pwm2_lb  <= 16'd0 + {1'b0, pwm2_duty };
		pwm2_ub  <= CLK_DIV - {1'b0, pwm2_duty };
		pwm3_lb  <= 16'd0 + {1'b0, pwm3_duty };
		pwm3_ub  <= CLK_DIV - {1'b0, pwm3_duty };
		pwm4_lb  <= 16'd0 + {1'b0, pwm4_duty };
		pwm4_ub  <= CLK_DIV - {1'b0, pwm4_duty };
		pwm5_lb  <= 16'd0 + {1'b0, pwm5_duty };
		pwm5_ub  <= CLK_DIV - {1'b0, pwm5_duty };
		pwm6_lb  <= 16'd0 + {1'b0, pwm6_duty };
		pwm6_ub  <= CLK_DIV - {1'b0, pwm6_duty };
		pwm7_lb  <= 16'd0 + {1'b0, pwm7_duty };
		pwm7_ub  <= CLK_DIV - {1'b0, pwm7_duty };
		pwm8_lb  <= 16'd0 + {1'b0, pwm8_duty };
		pwm8_ub  <= CLK_DIV - {1'b0, pwm8_duty };
		pwm9_lb  <= 16'd0 + {1'b0, pwm9_duty };
		pwm9_ub  <= CLK_DIV - {1'b0, pwm9_duty };
		pwm10_lb <= 16'd0 + {1'b0, pwm10_duty};
		pwm10_ub <= CLK_DIV - {1'b0, pwm10_duty};
		pwm11_lb <= 16'd0 + {1'b0, pwm11_duty};
		pwm11_ub <= CLK_DIV - {1'b0, pwm11_duty};
		pwm12_lb <= 16'd0 + {1'b0, pwm12_duty };
		pwm12_ub <= CLK_DIV - {1'b0, pwm12_duty };
		pwm13_lb <= 16'd0 + {1'b0, pwm13_duty };
		pwm13_ub <= CLK_DIV - {1'b0, pwm13_duty };
		pwm14_lb <= 16'd0 + {1'b0, pwm14_duty };
		pwm14_ub <= CLK_DIV - {1'b0, pwm14_duty };
		pwm15_lb <= 16'd0 + {1'b0, pwm15_duty };
		pwm15_ub <= CLK_DIV - {1'b0, pwm15_duty };
		pwm16_lb <= 16'd0 + {1'b0, pwm16_duty };
		pwm16_ub <= CLK_DIV - {1'b0, pwm16_duty };
		pwm17_lb <= 16'd0 + {1'b0, pwm17_duty };
		pwm17_ub <= CLK_DIV - {1'b0, pwm17_duty };
		pwm18_lb <= 16'd0 + {1'b0, pwm18_duty };
		pwm18_ub <= CLK_DIV - {1'b0, pwm18_duty };
		pwm19_lb <= 16'd0 + {1'b0, pwm19_duty };
		pwm19_ub <= CLK_DIV - {1'b0, pwm19_duty };
		pwm20_lb <= 16'd0 + {1'b0, pwm20_duty};
		pwm20_ub <= CLK_DIV - {1'b0, pwm20_duty};
		pwm21_lb <= 16'd0 + {1'b0, pwm21_duty};
		pwm21_ub <= CLK_DIV - {1'b0, pwm21_duty};
		pwm22_lb <= 16'd0 + {1'b0, pwm22_duty};
		pwm22_ub <= CLK_DIV - {1'b0, pwm22_duty};
		pwm_act <= 1'b1;
	end
end

always @ (posedge clk)
begin
	pwm_en <= pwm_act;
	pwm_1  <= ~pwm_act || cnt<=pwm1_lb  || cnt>pwm1_ub;
	pwm_2  <= ~pwm_act || cnt<=pwm2_lb  || cnt>pwm2_ub;
	pwm_3  <= ~pwm_act || cnt<=pwm3_lb  || cnt>pwm3_ub;
	pwm_4  <= ~pwm_act || cnt<=pwm4_lb  || cnt>pwm4_ub;
	pwm_5  <= ~pwm_act || cnt<=pwm5_lb  || cnt>pwm5_ub;
	pwm_6  <= ~pwm_act || cnt<=pwm6_lb  || cnt>pwm6_ub;
	pwm_7  <= ~pwm_act || cnt<=pwm7_lb  || cnt>pwm7_ub;
	pwm_8  <= ~pwm_act || cnt<=pwm8_lb  || cnt>pwm8_ub;
	pwm_9  <= ~pwm_act || cnt<=pwm9_lb  || cnt>pwm9_ub;
	pwm_10 <= ~pwm_act || cnt<=pwm10_lb || cnt>pwm10_ub;
	pwm_11 <= ~pwm_act || cnt<=pwm11_lb || cnt>pwm11_ub;
	pwm_12 <= ~pwm_act || cnt<=pwm12_lb || cnt>pwm12_ub;
	pwm_13 <= ~pwm_act || cnt<=pwm13_lb || cnt>pwm13_ub;
	pwm_14 <= ~pwm_act || cnt<=pwm14_lb || cnt>pwm14_ub;
	pwm_15 <= ~pwm_act || cnt<=pwm15_lb || cnt>pwm15_ub;
	pwm_16 <= ~pwm_act || cnt<=pwm16_lb || cnt>pwm16_ub;
	pwm_17 <= ~pwm_act || cnt<=pwm17_lb || cnt>pwm17_ub;
	pwm_18 <= ~pwm_act || cnt<=pwm18_lb || cnt>pwm18_ub;
	pwm_19 <= ~pwm_act || cnt<=pwm19_lb || cnt>pwm19_ub;
	pwm_20 <= ~pwm_act || cnt<=pwm20_lb || cnt>pwm20_ub;
	pwm_21 <= ~pwm_act || cnt<=pwm21_lb || cnt>pwm21_ub;
	pwm_22 <= ~pwm_act || cnt<=pwm22_lb || cnt>pwm22_ub;
end


reg [LM10_WIDTH-1:0] x1;
reg [LM10_WIDTH-3:0] x2;
reg        				s2;
reg        				z2;
reg [ 8:0] 				y3;
reg [ 8:0] 				y4;
reg        				s3;
reg        				z3;
reg						q1;
reg						q2;
reg						q3;


always @ (posedge clk)
begin
	if (rom_x >= `ENCODER_BIT'd3200) begin
		x1 <= LM10_COUNTS - rom_x;
		q1 <= 1'b1;
	end else begin
		x1 <= rom_x;
		q1 <= 1'b0;
	end
end

always @ (posedge clk)
begin
	z2 <= x1 == `ENCODER_BIT'd1600;
	q2 <= q1;
	if (x1 <= `ENCODER_BIT'd1600) begin
		x2 <= x1[LM10_WIDTH-3:0];
		s2 <= 1'b0;
	end else begin
		x2 <= `ENCODER_BIT_MIN2'(`ENCODER_BIT_MIN1'd3200 - x1[LM10_WIDTH-2:0]);
		s2 <= 1'b1;
	end
end

always @ (posedge clk)
begin
	z3 <= z2;
	s3 <= s2;
	q3 <= q2;
end

always @ (posedge clk)
begin
	rom_sy <= s3;
	if (z3)
		rom_y <= 9'd0;
	else if (q3) begin
		if (s3) 
			rom_y <= y3;
		else
			rom_y <= y4;
	end else begin
		if (s3) 
			rom_y <= y4;
		else
			rom_y <= y3;
	end
end

always @ (posedge clk)
case(x2)
11'd0:y3<=9'd508;
11'd1:y3<=9'd508;
11'd2:y3<=9'd508;
11'd3:y3<=9'd509;
11'd4:y3<=9'd509;
11'd5:y3<=9'd509;
11'd6:y3<=9'd508;
11'd7:y3<=9'd508;
11'd8:y3<=9'd508;
11'd9:y3<=9'd508;
11'd10:y3<=9'd508;
11'd11:y3<=9'd508;
11'd12:y3<=9'd508;
11'd13:y3<=9'd509;
11'd14:y3<=9'd509;
11'd15:y3<=9'd508;
11'd16:y3<=9'd509;
11'd17:y3<=9'd509;
11'd18:y3<=9'd509;
11'd19:y3<=9'd509;
11'd20:y3<=9'd508;
11'd21:y3<=9'd509;
11'd22:y3<=9'd508;
11'd23:y3<=9'd508;
11'd24:y3<=9'd508;
11'd25:y3<=9'd508;
11'd26:y3<=9'd508;
11'd27:y3<=9'd507;
11'd28:y3<=9'd508;
11'd29:y3<=9'd508;
11'd30:y3<=9'd508;
11'd31:y3<=9'd508;
11'd32:y3<=9'd507;
11'd33:y3<=9'd508;
11'd34:y3<=9'd508;
11'd35:y3<=9'd508;
11'd36:y3<=9'd508;
